<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine compiles code at run time. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- The engine loads the openDAQ SDK's modules, which carry no team
       identifier when the app is signed with a self-signed certificate. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Device discovery and connection happen over the local network. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
